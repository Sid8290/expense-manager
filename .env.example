# Copy this file to ".env" and fill in your own values. ".env" is ignored by Git.
# Never put real credentials in ".env.example".

# Connection URL for the app's PostgreSQL database.
DATABASE_URL=postgres://expense_user:CHANGE_ME@127.0.0.1:5432/expense_manager

# A SEPARATE database used only by the automated database tests. The tests
# create and drop their own schemas inside it. Never point this at the real one.
TEST_DATABASE_URL=postgres://expense_user:CHANGE_ME@127.0.0.1:5432/expense_manager_test

# Web server settings (unchanged from before).
# PORT=3000
# HOST=127.0.0.1
